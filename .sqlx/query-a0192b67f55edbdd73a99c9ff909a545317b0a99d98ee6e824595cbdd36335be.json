{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, user_id, name, tags, description, location, last_seen, searching\n        FROM items\n        WHERE user_id = $1\n          AND (name ILIKE $2 OR tags ILIKE $2 OR description ILIKE $2 OR location ILIKE $2)\n        ORDER BY searching DESC, name ASC\n        ",
